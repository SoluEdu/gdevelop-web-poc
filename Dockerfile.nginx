# ==============================================
# Dockerfile.nginx — reverse proxy baked, tanpa bind-mount
# nginx.conf di-COPY ke image, compose hanya pull (no build, no volumes).
# Base dipin sama seperti compose lama: nginx:1.27-alpine
# ==============================================
FROM nginx:1.27-alpine

# Patch base alpine 3.21.3 — upgrade fixed CVEs (c-ares, libcrypto3, openssl, libexpat, libpng, libxml2, musl, nghttp2, zlib) untuk lolos trivy HIGH,CRITICAL
RUN apk update && apk upgrade --no-cache && rm -rf /var/cache/apk/*

# Buang default bawaan image, ganti dengan config repo
RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Fail-fast kalau config typo
# RUN nginx -t

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
