# ==============================================
# Dockerfile.deploy — Plan A: pakai dist prebuilt dari Jenkins
# Jenkins stage 'Build' sudah jalankan `npm run build` + stash dist/**.
# Image ini TIDAK rebuild, hanya serve via node server.mjs.
# Build lokal / dev tetap pakai Dockerfile (multi-stage).
# ==============================================
FROM node:22-alpine

WORKDIR /app

# dist wajib ada (di-unstash Jenkins sebelum docker build)
COPY dist ./dist
COPY server.mjs ./

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:80/health || exit 1

CMD ["node", "server.mjs"]
